palcon.log

# Node / frontend
web/node_modules/
web/dist/*
!web/dist/.gitkeep
# Static demo build (CI builds it fresh for GitHub Pages)
web/dist-demo/
*.tsbuildinfo
# vitest --coverage output, regenerated on every run
web/coverage/

# UI screenshots taken while developing (Claude's headless-browser passes
# land here so they're viewable in the editor). Never committed.
/screenshots/

# Real Palworld saves used for local debugging. These hold player names and
# platform account IDs, and are far too big for the repo — the committed
# fixtures in internal/games/palworld/palsave/testdata/ are synthetic instead.
/localsaves/

# Python bytecode from the save extractor
__pycache__/
*.pyc

